#!/usr/bin/env bash
set -euo pipefail

REAL_PI="$HOME/.bun/bin/pi"

# Do not let an injected-default marker leak into a nested wrapper invocation.
unset PI_THEME_WRAPPER_INJECTED

run_real_pi() {
  exec node --liftoff-only "$REAL_PI" "$@"
}

# Escape hatch if the wrapper ever gets in the way:
#   PI_THEME_WRAPPER_DISABLE=1 pi ...
if [[ "${PI_THEME_WRAPPER_DISABLE:-}" == "1" ]]; then
  run_real_pi "$@"
fi

# Pi recognizes management commands only as argv[0]. Interactive theme selection
# does not apply to these commands and must not affect prompt text with the same words.
case "${1:-}" in
  auth|update|install|remove|uninstall|config|list)
    run_real_pi "$@"
    ;;
esac

# Parse only supported flags before `--`. Skip option values so text such as
# `--name --print` is not mistaken for a non-interactive mode flag.
should_inject_theme=1
explicit_use_theme=0
arguments=("$@")
index=0
while (( index < ${#arguments[@]} )); do
  argument="${arguments[$index]}"
  case "$argument" in
    --)
      break
      ;;
    --use-theme)
      explicit_use_theme=1
      ((index += 2))
      continue
      ;;
    -v|--version|-h|--help|-p|--print|--list-models|--export)
      should_inject_theme=0
      ;;
    --mode=json|--mode=rpc)
      should_inject_theme=0
      ;;
    --mode)
      next="${arguments[$((index + 1))]-}"
      if [[ "$next" == "json" || "$next" == "rpc" ]]; then
        should_inject_theme=0
      fi
      # Pi does not consume a missing or flag-looking mode value.
      if [[ -n "$next" && "$next" != -* ]]; then
        ((index += 2))
      else
        ((index += 1))
      fi
      continue
      ;;
    --provider|--model|--api-key|--thinking|--models|--name|-n|--session|--session-dir|--fork|--tools|-t|--exclude-tools|-xt|--extension|-e|--skill|--prompt-template|--theme|--system-prompt|--append-system-prompt|--tui-mode)
      ((index += 2))
      continue
      ;;
  esac
  ((index += 1))
done

if [[ "$should_inject_theme" == "0" || "$explicit_use_theme" == "1" ]]; then
  run_real_pi "$@"
fi

detect_windows_theme() {
  local reg=""

  for candidate in \
    "/mnt/c/Windows/System32/reg.exe" \
    "/mnt/c/WINDOWS/system32/reg.exe" \
    "/mnt/c/Windows/system32/reg.exe" \
    "reg.exe"
  do
    if [[ -f "$candidate" ]] || command -v "$candidate" >/dev/null 2>&1; then
      reg="$candidate"
      break
    fi
  done

  [[ -n "$reg" ]] || return 1

  local output
  output="$("$reg" Query 'HKCU\SOFTWARE\Microsoft\Windows\CurrentVersion\Themes\Personalize' /v AppsUseLightTheme 2>/dev/null || true)"

  [[ "$output" =~ AppsUseLightTheme ]] || return 1

  # Windows AppsUseLightTheme: 1 = light, 0 = dark.
  if [[ "$output" =~ 0x1([^0-9a-fA-F]|$) ]]; then
    printf 'light\n'
  else
    printf 'dark\n'
  fi
}

theme="$(detect_windows_theme || true)"

if [[ "$theme" == "dark" || "$theme" == "light" ]]; then
  # Prepend the default so every original argument remains byte-for-byte and in
  # order. The marker tells theme-overrides that this flag came from the wrapper,
  # so Windows appearance polling may continue after startup.
  PI_THEME_WRAPPER_INJECTED=1 run_real_pi --use-theme "$theme" "$@"
fi

run_real_pi "$@"
