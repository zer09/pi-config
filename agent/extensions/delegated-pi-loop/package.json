{
  "name": "pi-delegated-pi-loop-extension",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Native TypeScript delegated Pi RPC orchestration with config-driven routing, operational fallback, and same-session report recovery.",
  "scripts": {
    "test": "node --test tests/*.test.ts",
    "typecheck": "node typecheck.ts",
    "check:routing": "node check-routing.ts",
    "analyze:progress-gaps": "node analyze-progress-gaps.ts",
    "render:instructions-doc": "node render-instructions-doc.ts"
  },
  "pi": {
    "extensions": [
      "./index.ts"
    ]
  },
  "engines": {
    "node": ">=22.19.0"
  }
}
